{
  "buildCommand": "cd frontend && yarn install && yarn build && cd ../cms-backend && yarn install && yarn build",
  "outputDirectory": "frontend/build",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": ["backend/**"]
      }
    },
    {
      "src": "api/cms/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "includeFiles": ["cms-backend/**"]
      }
    }
  ],
  "rewrites": [
    { "source": "/api/cms/(.*)", "destination": "/api/cms/index.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}