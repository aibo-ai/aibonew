{
  "buildCommand": "cd frontend && echo 'Using build output committed by GitHub Actions' && npm install --legacy-peer-deps",
  "outputDirectory": "frontend/build",
  "redirects": [
    { "source": "/solutions/ai-ml", "destination": "/solutions/ai-automations", "permanent": true },
    { "source": "/solutions/ai-ml/:path*", "destination": "/solutions/ai-automations", "permanent": true },
    { "source": "/solutions/white-label", "destination": "/solutions/full-stack", "permanent": true },
    { "source": "/solutions/geo/wikipedia", "destination": "/solutions/geo/wikipedia-page-creation", "permanent": true },
    { "source": "/solutions/white-label/:path*", "destination": "/solutions/full-stack", "permanent": true },
    { "source": "/solutions/seo/community-ugc-search-amplification", "destination": "/solutions/geo/quora-content-seeding", "permanent": true },
    { "source": "/blog/:junk/blog/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/blog", "destination": "/blogs", "permanent": true },
    { "source": "/case-study", "destination": "/case-studies", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/cms/:path*", "destination": "/api/cms/index.ts" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/social-intelligence", "destination": "https://socialintelligence-psi.vercel.app/" },
    { "source": "/social-intelligence/:path*", "destination": "https://socialintelligence-psi.vercel.app/:path*" },
    { "source": "/Yippee-Intelligence/:path*", "destination": "https://socialintelligence-psi.vercel.app/Yippee-Intelligence/:path*" },
    { "source": "/(about|blogs|case-studies|contact)", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/index.html" },
    { "source": "/case-study/:id", "destination": "/index.html" },
    { "source": "/solutions/:pillar(geo|aeo|seo|content-marketing|ai-automations|full-stack)", "destination": "/index.html" },
    { "source": "/solutions/:pillar(geo|aeo|seo|content-marketing|ai-automations|full-stack)/:cluster", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(myaibo-logo.png|myaibo-logo-v2.png|myaibo-logo-white.png|og-default.png|favicon.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
