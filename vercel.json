{
  "buildCommand": "cd frontend && NODE_ENV=development npm install --legacy-peer-deps && npm run build",
  "outputDirectory": "frontend/build",
  "rewrites": [
    { "source": "/api/cms/:path*", "destination": "/api/cms/index.ts" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}