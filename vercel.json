{
  "buildCommand": "cd frontend && if git log -1 --pretty=%B | grep -q '\\[skip ci\\]'; then echo 'Skipping rebuild — using prerendered output from CI'; else NODE_ENV=development npm install --legacy-peer-deps && npm run build; fi",
  "outputDirectory": "frontend/build",
  "redirects": [
    { "source": "/solutions/ai-ml", "destination": "/solutions/ai-automations", "permanent": true },
    { "source": "/solutions/ai-ml/:path*", "destination": "/solutions/ai-automations", "permanent": true },
    { "source": "/solutions/white-label", "destination": "/solutions/full-stack", "permanent": true },
    { "source": "/solutions/white-label/:path*", "destination": "/solutions/full-stack", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/cms/:path*", "destination": "/api/cms/index.ts" },
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/social-intelligence", "destination": "https://socialintelligence-psi.vercel.app/" },
    { "source": "/social-intelligence/:path*", "destination": "https://socialintelligence-psi.vercel.app/:path*" },
    { "source": "/Yippee-Intelligence/:path*", "destination": "https://socialintelligence-psi.vercel.app/Yippee-Intelligence/:path*" },
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(myaibo-logo.png|myaibo-logo-white.png|og-default.png|favicon.ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
